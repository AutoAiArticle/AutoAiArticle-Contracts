{
  "name": "@autoai/contracts",
  "version": "0.1.0",
  "description": "Cross-service event contracts, HMAC signing, error codes, and idempotency rules for AutoAiArticle",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./fixtures": {
      "types": "./dist/fixtures.d.ts",
      "import": "./dist/fixtures.js"
    }
  },
  "files": [
    "dist",
    "fixtures"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "vitest run",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build",
    "prepublishOnly": "npm run verify"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "zod": "^3.24"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.5.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.1.0"
  }
}
